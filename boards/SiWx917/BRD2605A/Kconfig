config CHIP_CHOICE
    string
    default "SIWG917M111MGTBA"

config BOARD_CHOICE
    string
    default "BRD2605A"

config BOARD_NAME
    string
    default "brd2605a"

config BOARD_CONFIG
    bool
    default y
    select ENABLE_BUTTON
    select ENABLE_LED
    select ENABLE_AUDIO
    select ENABLE_AUDIO_CODECS
    select MP3_DECODER_STATIC_BUF

config BOARD_SW1_PIN
    int "BOARD_SW1_PIN"
    default 49

config BOARD_SW1_NAME
    string
    default "ai_chat_button"
    ---help---
        The name SW1 is registered under, and the one an application asks for
        by name. tuya.ai/your_chat_bot hard-codes "ai_chat_button"
        (ai_chat_main.c) and aborts init when tdl_button_create cannot find
        it, so the board has to publish that name -- which is what
        SIWX917_AI_DEV_KIT already does. Not settable from a .config: this
        symbol has no prompt, so a value written there is ignored.

