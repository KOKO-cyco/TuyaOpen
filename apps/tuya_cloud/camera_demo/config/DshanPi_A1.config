# camera_demo — DshanPi A1 (LINUX): V4L2 camera capture
# Usage:
#   cd apps/tuya_cloud/camera_demo
#   tos.py config choice -c DshanPi_A1.config
#   tos.py build
#
# Camera: shared V4L2 TDD in boards/LINUX/common/camera, node from
#         CONFIG_CAMERA_V4L2_DEVNODE below.

CONFIG_BOARD_CHOICE_LINUX=y
CONFIG_BOARD_CHOICE_DshanPI_A1=y

CONFIG_ENABLE_CAMERA=y
CONFIG_ENABLE_CAMERA_V4L2=y
CONFIG_CAMERA_V4L2_DEVNODE="/dev/video0"
CONFIG_CAMERA_NAME="camera_dvp"

# Audio: ALSA capture/playback for two-way talk.
# NOTE: the LINUX platform compiles tkl_vad.c unconditionally and that file
# calls tdd_audio_alsa_unregister_vad_feed_cb(), whose header only lands on the
# include path when ENABLE_AUDIO_CODECS is on. Leaving it off breaks the build.
CONFIG_ENABLE_AUDIO_CODECS=y
CONFIG_ENABLE_AUDIO_ALSA=y

CONFIG_ENABLE_TUYA_P2P=y
CONFIG_ENABLE_WIRED=y
# CONFIG_ENABLE_WIFI is not set

CONFIG_ENABLE_LOCAL_STORE=y
CONFIG_LOCAL_STORE_ROOT="./media"
CONFIG_LOCAL_STORE_REC_SUBDIR="rec"
CONFIG_LOCAL_STORE_PATH_MAX=256
CONFIG_ENABLE_IPC_RING_BUFFER=y

CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096

# Headless: no LVGL / SDL window
# CONFIG_ENABLE_KEYBOARD_INPUT is not set
